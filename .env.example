# Copia este archivo a ".env" en el mismo directorio (junto a docker-compose.yml)
# y reemplaza cada valor. ".env" NUNCA se sube a git (ya está en .gitignore).

# Contraseña del usuario "sa" de SQL Server dentro del contenedor.
# Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.
SQL_SA_PASSWORD=

# Secreto para firmar los JWT de sesión — genera uno nuevo y aleatorio,
# nunca reutilices el que se usó en desarrollo local.
# Puedes generar uno con: openssl rand -base64 48
JWT_SECRET=

# Zoho Mail: usados para enviar notificaciones (nueva cita, mensaje,
# recordatorios, restablecer contraseña). SMTP_USER es la cuenta completa
# (p. ej. contacto@ecgabogados.com); SMTP_PASSWORD normalmente debe ser una
# "contraseña de aplicación" generada desde Zoho (Configuración > Seguridad >
# Contraseñas de aplicación), no la contraseña de inicio de sesión normal.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contacto@ecgabogados.com

# A dónde llegan los avisos internos del despacho (nuevo mensaje, nueva cita, etc.)
STAFF_EMAIL=
